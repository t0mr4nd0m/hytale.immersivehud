# Commands #
cmd.ihud="ImmersiveHud plugin commands."
cmd.config="Open the ImmersiveHud configuration UI."

# Config UI #
gui.title="Immersive Hud Config"

gui.profile.button="Profile"
gui.profile.button.tooltip="Choose a profile to instantly apply a preset HUD experience.\nProfiles provide predefined configurations tailored for different playstyles."

gui.visibility.button="Visibility"
gui.visibility.button.tooltip="Lorem Ipsum"

gui.apply.button="Apply"
gui.cancel.button="Cancel"

# Profile UI #
gui.profile.balanced="Balanced"
gui.profile.balanced.description="Balanced experience. [RECOMMENDED]\nHUD elements appear only when relevant during gameplay."

gui.profile.immersive="Immersive"
gui.profile.immersive.description="Minimal HUD, maximum immersion. [ADVANCED]\nMost elements stay hidden and only some of them appear only during key gameplay moments."

gui.profile.vanilla="Vanilla"
gui.profile.vanilla.description="Original Hytale HUD experience.\nAll HUD elements remain visible at all times."

gui.profile.custom="Custom"
gui.profile.custom.description="Your personalized HUD configuration.\nYou’ve customized HUD visibility beyond predefined profiles."

# Visibility UI #
gui.visibility.static.components.button.tooltip="Static Components"

gui.toggle.visibility.button.tooltip="Toggle visibility"

gui.triggers="TRIGGERS ({active}/{total})"
gui.uncheck.all.button.tooltip="Uncheck all triggers"
gui.filter.button.tooltip="Filter active triggers"
gui.triggers.checkbox.tooltip="Check to apply trigger"

# Trigger descriptions (shown when hovering over a trigger name) #
gui.trigger.hotbar_input.tooltip="Shows this HUD element when you change the selected hotbar slot."
gui.trigger.consumable_use.tooltip="Shows this HUD element while using food, potions, or other consumables."
gui.trigger.target_entity.tooltip="Shows this HUD element when you aim at an entity within targeting range."
gui.trigger.interactable_block.tooltip="Shows this HUD element when you look at a block you can interact with, such as a door or chest."
gui.trigger.holding_building_block.tooltip="Shows this HUD element while holding a placeable item or building block."
gui.trigger.player_moving.tooltip="Shows this HUD element during movement, including walking, running, swimming, flying, and jumping."
gui.trigger.player_walking.tooltip="Shows this HUD element while walking."
gui.trigger.player_running.tooltip="Shows this HUD element while running."
gui.trigger.player_sprinting.tooltip="Shows this HUD element while sprinting."
gui.trigger.player_mounting.tooltip="Shows this HUD element while the game reports the mounted movement state."
gui.trigger.player_swimming.tooltip="Shows this HUD element while swimming."
gui.trigger.player_flying.tooltip="Shows this HUD element while flying."
gui.trigger.player_gliding.tooltip="Shows this HUD element while gliding."
gui.trigger.player_jumping.tooltip="Shows this HUD element while jumping."
gui.trigger.player_crouching.tooltip="Shows this HUD element while crouching."
gui.trigger.player_climbing.tooltip="Shows this HUD element while climbing."
gui.trigger.player_falling.tooltip="Shows this HUD element while falling."
gui.trigger.player_rolling.tooltip="Shows this HUD element while rolling."
gui.trigger.player_idle.tooltip="Shows this HUD element while the game reports that you are idle."
gui.trigger.player_sitting.tooltip="Shows this HUD element while sitting."
gui.trigger.player_sleeping.tooltip="Shows this HUD element while sleeping."
gui.trigger.player_in_fluid.tooltip="Shows this HUD element while in water or another fluid, even when you are not swimming."
gui.trigger.player_on_ground.tooltip="Shows this HUD element while on the ground."
gui.trigger.charging_weapon.tooltip="Shows this HUD element during a primary weapon action, such as attacking or charging. Holding a weapon alone does not activate it."
gui.trigger.holding_ranged_weapon.tooltip="Shows this HUD element while holding a ranged weapon. You do not need to aim or attack."
gui.trigger.holding_melee_weapon.tooltip="Shows this HUD element while holding a melee weapon. You do not need to attack."
gui.trigger.blocking_attack.tooltip="Shows this HUD element during a secondary weapon action, such as blocking. An incoming attack is not required."
gui.trigger.in_combat.tooltip="Shows this HUD element when a hostile NPC is detected ahead or an NPC is attacking you."
gui.trigger.health_not_full.tooltip="Shows this HUD element when health is below the percentage set by the slider."
gui.trigger.stamina_not_full.tooltip="Shows this HUD element when stamina is below the percentage set by the slider."
gui.trigger.mana_not_full.tooltip="Shows this HUD element when mana is below the percentage set by the slider."
gui.trigger.oxygen_not_full.tooltip="Shows this HUD element when oxygen is below the percentage set by the slider."

gui.threshold="BELOW"

msg.visibility.disabled.triggers="Triggers disabled while component is set to VISIBLE"
msg.visibility.no.triggers="No active triggers. This component will remain hidden at all times"


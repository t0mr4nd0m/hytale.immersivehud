# Comandos #
cmd.ihud="Comandos del mod ImmersiveHud."
cmd.config="Abre la interfaz de configuración de ImmersiveHud."

# Interfaz de configuración #
gui.title="Configuración de Immersive HUD"

gui.profile.button="Perfiles"
gui.profile.button.tooltip="Elige un perfil para aplicar al instante una configuración del HUD.\nLos perfiles ofrecen configuraciones predefinidas para distintos estilos de juego."

gui.visibility.button="Personalizar"
gui.visibility.button.tooltip="Personaliza qué elementos del HUD aparecen y cuándo se muestran."

gui.apply.button="Aplicar"
gui.cancel.button="Cancelar"

# Interfaz de perfiles #
gui.profile.balanced="Equilibrado"
gui.profile.balanced.description="Una experiencia equilibrada. [RECOMENDADO]\nLos elementos del HUD solo aparecen cuando son relevantes durante la partida."

gui.profile.immersive="Inmersivo"
gui.profile.immersive.description="HUD mínimo, máxima inmersión. [AVANZADO]\nLa mayoría de los elementos permanecen ocultos y solo algunos aparecen en momentos clave de la partida."

gui.profile.vanilla="Original"
gui.profile.vanilla.description="La experiencia original del HUD de Hytale.\nTodos los elementos del HUD permanecen visibles en todo momento."

gui.profile.custom="Personalizado"
gui.profile.custom.description="Tu configuración personalizada del HUD.\nHas ajustado la visibilidad del HUD más allá de los perfiles predefinidos."

# Interfaz de visibilidad #
gui.visibility.static.components.button.tooltip="Componentes estáticos"

gui.toggle.visibility.button.tooltip="Cambiar visibilidad"

gui.triggers="ACTIVADORES ({active}/{total})"
gui.uncheck.all.button.tooltip="Desmarcar todos los activadores"
gui.filter.button.tooltip="Filtrar activadores activos"
gui.triggers.checkbox.tooltip="Marca la casilla para aplicar el activador"


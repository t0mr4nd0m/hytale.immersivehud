# Config UI #
gui.title="Immersive HUD 设置"

gui.profile.button="配置方案"
gui.profile.button.tooltip="选择一个方案，即可立即应用预设的 HUD 配置。\n配置方案提供适合不同游玩风格的预设设置。"

gui.visibility.button="自定义"
gui.visibility.button.tooltip="自定义显示哪些 HUD 元素以及它们的显示时机。"

gui.apply.button="应用"
gui.cancel.button="取消"

# Profile UI #
gui.profile.balanced="均衡"
gui.profile.balanced.description="均衡的游戏体验。[推荐]\nHUD 元素仅在游戏中需要时显示。"

gui.profile.immersive="沉浸"
gui.profile.immersive.description="精简 HUD，尽享沉浸体验。[进阶]\n大多数元素保持隐藏，仅部分元素会在游戏的关键时刻显示。"

gui.profile.vanilla="原版"
gui.profile.vanilla.description="Hytale 原版 HUD 体验。\n所有 HUD 元素始终显示。"

gui.profile.custom="自定义"
gui.profile.custom.description="你的个性化 HUD 配置。\n你已在预设方案的基础上调整了 HUD 的显示设置。"


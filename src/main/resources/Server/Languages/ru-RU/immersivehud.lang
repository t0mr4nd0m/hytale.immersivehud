# Config UI #
gui.title="Настройка Immersive HUD"

gui.profile.button="Профили"
gui.profile.button.tooltip="Выберите профиль, чтобы сразу применить готовые настройки HUD.\nПрофили предлагают готовые конфигурации для разных стилей игры."

gui.visibility.button="Настроить"
gui.visibility.button.tooltip="Настройте, какие элементы HUD отображаются и когда они появляются."

gui.apply.button="Применить"
gui.cancel.button="Отмена"

# Profile UI #
gui.profile.balanced="Сбалансированный"
gui.profile.balanced.description="Сбалансированный игровой опыт. [РЕКОМЕНДУЕТСЯ]\nЭлементы HUD появляются только тогда, когда они нужны во время игры."

gui.profile.immersive="Погружение"
gui.profile.immersive.description="Минимум HUD, максимум погружения. [ДЛЯ ОПЫТНЫХ]\nБольшинство элементов скрыты, и лишь некоторые появляются в ключевые моменты игры."

gui.profile.vanilla="Оригинальный"
gui.profile.vanilla.description="Оригинальный интерфейс Hytale.\nВсе элементы HUD видны постоянно."

gui.profile.custom="Свой"
gui.profile.custom.description="Ваши собственные настройки HUD.\nВы изменили видимость HUD за пределами готовых профилей."


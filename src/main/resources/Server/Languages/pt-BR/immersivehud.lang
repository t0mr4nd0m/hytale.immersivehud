# Commands #
cmd.ihud="Comandos do mod ImmersiveHud."
cmd.config="Abre a interface de configuração do ImmersiveHud."

# Config UI #
gui.title="Configuração do Immersive HUD"

gui.profile.button="Perfis"
gui.profile.button.tooltip="Escolha um perfil para aplicar instantaneamente uma configuração do HUD.\nOs perfis oferecem configurações predefinidas para diferentes estilos de jogo."

gui.visibility.button="Personalizar"
gui.visibility.button.tooltip="Personalize quais elementos do HUD aparecem e quando são exibidos."

gui.apply.button="Aplicar"
gui.cancel.button="Cancelar"

# Profile UI #
gui.profile.balanced="Equilibrado"
gui.profile.balanced.description="Uma experiência equilibrada. [RECOMENDADO]\nOs elementos do HUD aparecem apenas quando são relevantes durante o jogo."

gui.profile.immersive="Imersivo"
gui.profile.immersive.description="HUD mínimo, imersão máxima. [AVANÇADO]\nA maioria dos elementos permanece oculta e apenas alguns aparecem em momentos importantes do jogo."

gui.profile.vanilla="Original"
gui.profile.vanilla.description="A experiência original do HUD do Hytale.\nTodos os elementos do HUD permanecem visíveis o tempo todo."

gui.profile.custom="Personalizado"
gui.profile.custom.description="Sua configuração personalizada do HUD.\nVocê ajustou a visibilidade do HUD além dos perfis predefinidos."

# Visibility UI #
gui.visibility.static.components.button.tooltip="Componentes estáticos"

gui.toggle.visibility.button.tooltip="Alternar visibilidade"

gui.triggers="GATILHOS ({active}/{total})"
gui.uncheck.all.button.tooltip="Desmarcar todos os gatilhos"
gui.filter.button.tooltip="Filtrar gatilhos ativos"
gui.triggers.checkbox.tooltip="Marque para aplicar o gatilho"

